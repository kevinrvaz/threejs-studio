# The TrueFoundry AI Gateway base URL, including its /v1 path.
TFY_GATEWAY_BASE_URL=https://gateway.example.com/v1
# Set this in your shell or secret manager. Do not commit a real token.
TFY_API_KEY=
# Use the exact model slug configured in your TrueFoundry gateway.
TFY_MODEL=openai/gpt-6-astra

# Chrome must be running with --remote-debugging-port=9222 and WebMCP enabled.
CDP_URL=http://127.0.0.1:9222
# The already-open Three.js Studio tab to control.
STUDIO_URL=http://127.0.0.1:5173/

# Optional guardrails.
AGENT_MAX_TOOL_ITERATIONS=16
AGENT_REASONING_EFFORT=high
